<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-reverse-engineering PUBLIC "-//Hibernate/Hibernate Reverse Engineering DTD 3.0//EN" "http://hibernate.org/dtd/hibernate-reverse-engineering-3.0.dtd" >

<hibernate-reverse-engineering>
	<table-filter match-name="login" match-schema="mydb"></table-filter>
	<table catalog="mydb" name="login">
		<column name="uname"></column>
		<column name="pass"></column>
		<column name="role"></column>
	</table>
</hibernate-reverse-engineering>